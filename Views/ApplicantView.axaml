<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HR_Applicant_System.Views.ApplicantView"
        Title="Applicant Dashboard" Width="800" Height="600">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Welcome, Applicant!" FontSize="30" FontWeight="Bold"/>
            <TextBlock Text="Your job search starts here." HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>