<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="using:HR_Applicant_System.Models"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
        x:Class="HR_Applicant_System.Views.FinalReviewView"
        Title="Final Review - HR Department">

    <Grid RowDefinitions="*, Auto, Auto" Margin="20">
        
        <ListBox Name="applicantList" Grid.Row="0">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:Application">
                    <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,2">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0" Spacing="5">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="{Binding Position}" Foreground="LightGray" FontSize="12"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Status}" 
                                       Foreground="#F59E0B" VerticalAlignment="Center" FontWeight="Bold"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="1" Margin="0,15,0,0" Spacing="10">
            <TextBlock Text="Admin Final Hiring Decision Remarks:" Foreground="LightGray"/>
            <TextBox Name="txtFinalRemarks" Height="70" AcceptsReturn="True"
                     PlaceholderText="Enter final package offers, decision remarks or contract details here..."/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0" Spacing="12">
            <Button Name="btnReject" Content="Reject Application" Background="#EF4444" Foreground="White" Padding="15,8" FontWeight="Bold"/>
            <Button Name="btnApprove" Content="Approve &amp; Issue Offer" Background="#10B981" Foreground="White" Padding="15,8" FontWeight="Bold"/>
        </StackPanel>
        
    </Grid>
</Window>