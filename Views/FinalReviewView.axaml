<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:HR_Applicant_System.Models"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
        x:Class="HR_Applicant_System.Views.FinalReviewView"
        Title="HR Capstone - Final Review Panel"
        Background="#121212"
        WindowStartupLocation="CenterScreen"
        Width="800" Height="500">

    <Grid ColumnDefinitions="2*, 3*" Margin="20">
        <Border Grid.Column="0" Background="#1e1e1e" CornerRadius="8" Margin="0,0,10,0" Padding="15">
            <Grid RowDefinitions="Auto, *">
                <TextBlock Grid.Row="0" Text="Applications For Review" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>
                <ListBox Grid.Row="1" Name="applicantList" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:Application">
                            <StackPanel Margin="5">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="{Binding Position}" FontSize="12" Foreground="#aaaaaa"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="#1e1e1e" CornerRadius="8" Margin="10,0,0,0" Padding="20">
            <StackPanel Spacing="15">
                <TextBlock Text="Executive Decision Desk" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <Separator Background="#333333"/>

                <StackPanel DataContext="{Binding #applicantList.SelectedItem}" x:DataType="models:Application" Spacing="5">
                    <TextBlock Text="Selected Candidate Profile" FontSize="12" Foreground="#888888"/>
                    <TextBlock Text="{Binding Name}" FontSize="16" Foreground="White" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Position}" FontSize="14" Foreground="#aaaaaa"/>
                </StackPanel>

                <StackPanel Spacing="5">
                    <TextBlock Text="Final Decision Remarks / Feedback" FontSize="12" Foreground="#888888"/>
                    <TextBox Name="txtFinalRemarks" PlaceholderText="Type executive decision justifications here..." Height="120" TextWrapping="Wrap" AcceptsReturn="True" Background="#2d2d2d" Foreground="White" BorderBrush="#444444"/>
                </StackPanel>

                <Grid ColumnDefinitions="*, *" Margin="0,10,0,0">
                    <Button Grid.Column="0" Name="btnReject" Content="Reject Candidate" Background="#D32F2F" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12" Margin="0,0,10,0"/>
                    <Button Grid.Column="1" Name="btnApprove" Content="Approve &amp; Hire" Background="#388E3C" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12" Margin="10,0,0,0"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>