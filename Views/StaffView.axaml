<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:HR_Applicant_System.Views"
        xmlns:vm="clr-namespace:HR_Applicant_System.ViewModels"
        x:Class="HR_Applicant_System.Views.StaffView"
        x:DataType="vm:ApplicantListViewModel"
        Title="HR Staff Portal" 
        Width="1200" 
        Height="750"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e1e">
    
    <Grid RowDefinitions="Auto,*">
        <!-- Top Control Header Bar -->
        <Border Grid.Row="0" Background="#1F2937" Padding="15">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="HR Staff Dashboard" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                        <TextBlock Text="Active Reviewer:" Foreground="#9ca3af" FontSize="12"/>
                        <TextBlock Text="{Binding FullName}" Foreground="#60a5fa" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <!-- Standard Pipeline Toggle -->
                    <Button Content="Main Pipeline" 
                            Background="#374151" 
                            Foreground="White" 
                            Padding="15,7" 
                            FontWeight="Bold"
                            Click="MainPipeline_Click"/>

                    <!-- Queue Views (Now function as inline tab switches instead of popups) -->
                    <Button Content="Final Review Queue" 
                            Background="#10B981" 
                            Foreground="White" 
                            Padding="15,7" 
                            FontWeight="Bold"
                            Click="FinalReview_Click"/>
                            
                    <Button Content="Rejected Queue" 
                            Background="#4B5563" 
                            Foreground="White" 
                            Padding="15,7" 
                            FontWeight="Bold"
                            Click="RejectedQueue_Click"/>

                    <Button Content="Logout" 
                            Background="#dc2626" 
                            Foreground="White" 
                            Padding="15,7" 
                            FontWeight="Bold"
                            Click="Logout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Workspace Body -->
        <Grid Grid.Row="1" Margin="20">
            <views:ApplicantListView Name="MainApplicantList" />
        </Grid>
    </Grid>
</Window>