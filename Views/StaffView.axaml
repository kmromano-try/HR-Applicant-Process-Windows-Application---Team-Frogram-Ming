<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HR_Applicant_System.Views.StaffView"
        Title="HR Staff Portal" Width="800" Height="600">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="HR Staff Dashboard" FontSize="30" FontWeight="Bold" Foreground="Blue"/>
            <TextBlock Text="Reviewing applications..." HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>