<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HR_Applicant_System.ViewModels"
             x:Class="HR_Applicant_System.Views.ApplicantListView"
             x:DataType="vm:ApplicantListViewModel"
             Background="#F8F9FA">

    <Grid ColumnDefinitions="350, *">
        <Border Grid.Column="0" Background="White" BorderBrush="#E9ECEF" BorderThickness="0,0,1,0" Padding="20">
            <StackPanel Spacing="15">
                <TextBlock Text="HR Staff Profile" FontSize="18" FontWeight="Bold" Foreground="#212529" Margin="0,0,0,10"/>
                
                <StackPanel Spacing="5">
                    <TextBlock Text="Full Name" FontSize="12" Foreground="#6C757D" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding FullName, Mode=TwoWay}"/>
                </StackPanel>

                <StackPanel Spacing="5">
                    <TextBlock Text="Email Address" FontSize="12" Foreground="#6C757D" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding StaffEmail, Mode=TwoWay}"/>
                </StackPanel>

                <StackPanel Spacing="5">
                    <TextBlock Text="Department" FontSize="12" Foreground="#6C757D" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding Department, Mode=TwoWay}"/>
                </StackPanel>

                <StackPanel Spacing="5">
                    <TextBlock Text="Bio / System Notes" FontSize="12" Foreground="#6C757D" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding Bio, Mode=TwoWay}" Height="80" AcceptsReturn="True" TextWrapping="Wrap"/>
                </StackPanel>

                <Button Content="Save Profile" 
                        Command="{Binding SaveProfile}" 
                        Background="#0D6EFD" 
                        Foreground="White" 
                        HorizontalAlignment="Stretch" 
                        HorizontalContentAlignment="Center" 
                        Padding="10" 
                        Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto, *" Margin="20">
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,20">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Applicant Evaluation Pipeline" FontSize="20" FontWeight="Bold" Foreground="#212529"/>
                    <TextBlock Text="Live tracking records connected to hr_capstone_db" FontSize="12" Foreground="#6C757D"/>
                </StackPanel>
                
                <Button Grid.Column="1" 
                        Content="Sync Workspace Data" 
                        Command="{Binding RefreshDashboard}" 
                        Background="#198754" 
                        Foreground="White" 
                        Padding="12,8"
                        FontWeight="SemiBold"/>
            </Grid>

            <ListBox Grid.Row="1" ItemsSource="{Binding Applicants}" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,10" Padding="15" Background="White" CornerRadius="6" BoxShadow="0 2 4 0 #10000000">
                            <Grid ColumnDefinitions="*, *, *">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Applicant Name" FontSize="11" Foreground="#6C757D"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#212529" FontSize="14"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Target Position" FontSize="11" Foreground="#6C757D"/>
                                    <TextBlock Text="{Binding Position}" Foreground="#495057" FontSize="14"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Status" FontSize="11" Foreground="#6C757D" HorizontalAlignment="Right"/>
                                    <Border Background="#E8F5E9" Padding="8,4" CornerRadius="4">
                                        <TextBlock Text="{Binding Status}" FontWeight="Bold" Foreground="#2E7D32" FontSize="12"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>