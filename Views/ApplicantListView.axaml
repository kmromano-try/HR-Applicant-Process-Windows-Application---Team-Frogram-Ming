<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HR_Applicant_System.ViewModels"
             x:Class="HR_Applicant_System.Views.ApplicantListView"
             x:DataType="vm:ApplicantListViewModel"
             Background="#1e1e1e">

    <Grid ColumnDefinitions="350, *">
        <Border Grid.Column="0" Background="#252525" BorderBrush="#333333" BorderThickness="0,0,1,0" Padding="20">
            <StackPanel Spacing="15">
                <TextBlock Text="HR Staff Profile" FontSize="18" FontWeight="Bold" Foreground="#ffffff" Margin="0,0,0,10"/>
                
                <StackPanel Spacing="5">
                    <TextBlock Text="Full Name" FontSize="12" Foreground="#e0e0e0" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding FullName, Mode=TwoWay}"/>
                </StackPanel>

                <StackPanel Spacing="5">
                    <TextBlock Text="Email Address" FontSize="12" Foreground="#e0e0e0" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding StaffEmail, Mode=TwoWay}"/>
                </StackPanel>

                <StackPanel Spacing="5">
                    <TextBlock Text="Department" FontSize="12" Foreground="#e0e0e0" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding Department, Mode=TwoWay}"/>
                </StackPanel>

                <StackPanel Spacing="5">
                    <TextBlock Text="Bio / System Notes" FontSize="12" Foreground="#e0e0e0" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding Bio, Mode=TwoWay}" Height="80" AcceptsReturn="True" TextWrapping="Wrap"/>
                </StackPanel>

                <Button Content="Save Profile" 
                        Command="{Binding SaveProfile}" 
                        Background="#0D6EFD" 
                        Foreground="White" 
                        HorizontalAlignment="Stretch" 
                        HorizontalContentAlignment="Center" 
                        Padding="10" 
                        Margin="0,10,0,0"/>

                <Button Content="Logout to Main Menu" 
                        Click="Logout_Click" 
                        Background="#ef4444" 
                        Foreground="White" 
                        HorizontalAlignment="Stretch" 
                        HorizontalContentAlignment="Center" 
                        Padding="10" 
                        Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto, *, Auto" Margin="20">
            
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,20">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Applicant Evaluation Pipeline" FontSize="20" FontWeight="Bold" Foreground="#ffffff"/>
                    <TextBlock Text="Live tracking records connected to hr_capstone_db" FontSize="12" Foreground="#e0e0e0"/>
                </StackPanel>
                
                <Button Grid.Column="1" 
                        Content="Sync Workspace Data" 
                        Command="{Binding RefreshDashboard}" 
                        Background="#198754" 
                        Foreground="White" 
                        Padding="12,8"
                        FontWeight="SemiBold"/>
            </Grid>

            <ListBox Grid.Row="1" 
                     ItemsSource="{Binding Applicants}" 
                     SelectedItem="{Binding SelectedApplicant, Mode=TwoWay}"
                     Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,10" Padding="15" Background="#2d2d2d" CornerRadius="6" BoxShadow="0 2 4 0 #000000">
                            <Grid ColumnDefinitions="*, *, *">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Applicant Name" FontSize="11" Foreground="#e0e0e0"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#ffffff" FontSize="14"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Target Position" FontSize="11" Foreground="#e0e0e0"/>
                                    <TextBlock Text="{Binding Position}" Foreground="#ffffff" FontSize="14"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Status" FontSize="11" Foreground="#e0e0e0" HorizontalAlignment="Right"/>
                                    <Border Background="#1b5e20" Padding="8,4" CornerRadius="4">
                                        <TextBlock Text="{Binding Status}" FontWeight="Bold" Foreground="#ffffff" FontSize="12"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="15" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="Fail Application" 
                        Command="{Binding FailApplication}" 
                        Background="#ef4444" 
                        Foreground="White" 
                        Padding="18,10"
                        FontWeight="Bold"
                        CornerRadius="4"/>
                
                <Button Content="Pass Application" 
                        Command="{Binding PassApplication}" 
                        Background="#0D6EFD" 
                        Foreground="White" 
                        Padding="18,10"
                        FontWeight="Bold"
                        CornerRadius="4"/>
            </StackPanel>
            
        </Grid>
    </Grid>
</UserControl>