<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HR_Applicant_System.Views.ApplicantDetailView"
        Title="Applicant Details"
        Width="600" Height="400">
    <StackPanel Margin="20">
        <TextBlock x:Name="txtName" FontSize="20" FontWeight="Bold"/>
        <TextBlock x:Name="txtBio" TextWrapping="Wrap" Margin="0,10,0,0"/>
    </StackPanel>
</Window>