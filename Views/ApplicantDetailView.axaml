<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="500"
             x:Class="HR_Applicant_System.Views.ApplicantDetailView">
    <Border Padding="20" Background="#1e1e1e" CornerRadius="8">
        <StackPanel Spacing="15">
            <TextBlock Text="Applicant Profile Details" FontSize="18" FontWeight="Bold" Foreground="White"/>
            
            <StackPanel Spacing="5">
                <TextBlock Text="Full Name" FontSize="12" Foreground="#888888"/>
                <TextBlock Name="lblFullName" FontSize="16" Foreground="White" FontWeight="SemiBold"/>
            </StackPanel>

            <StackPanel Spacing="5">
                <TextBlock Text="Applied Position" FontSize="12" Foreground="#888888"/>
                <TextBlock Name="lblPosition" FontSize="14" Foreground="White"/>
            </StackPanel>

            <StackPanel Spacing="5">
                <TextBlock Text="Current Status" FontSize="12" Foreground="#888888"/>
                <TextBlock Name="lblStatus" FontSize="14" Foreground="#4CAF50" FontWeight="Bold"/>
            </StackPanel>

            <StackPanel Spacing="5">
                <TextBlock Text="HR Assessment / Remarks" FontSize="12" Foreground="#888888"/>
                <TextBlock Name="lblRemarks" FontSize="14" Foreground="White" TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>