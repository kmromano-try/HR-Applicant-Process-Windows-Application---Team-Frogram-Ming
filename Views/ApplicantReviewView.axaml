<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HR_Applicant_System.Views.ApplicantReviewView"
        Title="Applicant Review &amp; Screening"
        Width="600" Height="700"
        WindowStartupLocation="CenterScreen">
    
    <ScrollViewer>
        <StackPanel Margin="20">
            <TextBlock Text="Applicant Evaluation Pipeline" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>

            <Border BorderBrush="Gray" BorderThickness="1" Padding="15">
                <StackPanel Spacing="10">
                    <TextBlock Text="Applicant Profile" FontWeight="Bold" FontSize="16"/>
                    <TextBlock x:Name="FullNameText" Text="Name: Loading..."/>
                    <TextBlock x:Name="TargetPositionText" Text="Target Position: Loading..."/>
                    <TextBlock Text="Bio / System Notes:" FontWeight="Bold" Margin="0,10,0,0"/>
                    <TextBox x:Name="BioText" IsReadOnly="True" Height="80" TextWrapping="Wrap"/>
                    
                    <Button Content="View Submitted Resume" Click="OnViewDocumentsClicked" Background="#007bff" Foreground="White"/>
                </StackPanel>
            </Border>

            <Border BorderBrush="Gray" BorderThickness="1" Padding="15">
                <StackPanel Spacing="10">
                    <TextBlock Text="Screening Action" FontWeight="Bold" FontSize="16"/>
                    
                    <TextBlock Text="Decision:"/>
                    <ComboBox x:Name="DecisionDropdown" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Qualified (Staff Approved)"/>
                        <ComboBoxItem Content="Not Qualified (Staff Rejected)"/>
                    </ComboBox>

                    <TextBlock Text="Screening Remarks:"/>
                    <TextBox x:Name="RemarksInput" AcceptsReturn="True" Height="80" TextWrapping="Wrap" PlaceholderText="Enter evaluation notes here..."/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="15" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Content="Submit Screening" Click="OnSubmitScreeningClicked" Background="#28a745" Foreground="White" Width="150" HorizontalContentAlignment="Center"/>
                <Button Content="Cancel / Close" Click="OnCancelClicked" Background="#dc3545" Foreground="White" Width="150" HorizontalContentAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>