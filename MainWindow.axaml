<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HR_Applicant_System.MainWindow"
        Width="900"
        Height="600"
        Title="HR Applicant System"
        Background="#1e1e1e">

    <Grid RowDefinitions="120,*">
        
        <Border Background="#1F2937" Padding="20">
            <TextBlock Text="HR Applicant Process System"
                       Foreground="#ffffff"
                       FontSize="30"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <StackPanel Grid.Row="1" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center" 
                        Spacing="15" 
                        Width="320">
            
            <Button Content="Applicant Portal" 
                    Height="45" 
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Click="Applicant_Click"/>
            
            <Button Content="HR Staff Portal" 
                    Height="45" 
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Click="Staff_Click"/>
            
            <Button Content="Admin / Manager Dashboard" 
                    Height="45" 
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Click="Admin_Click"/>
            
        </StackPanel>
    </Grid>
</Window>